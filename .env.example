PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
DATA_DIR=./data
# Optional: 64 hex characters. Otherwise generated in data/.encryption-key.
# ENCRYPTION_KEY=
# Set true only behind an HTTPS reverse proxy.
COOKIE_SECURE=false
# Set to 1 only behind one trusted reverse proxy, with direct app access blocked.
TRUST_PROXY=0
SYNC_INTERVAL_MINUTES=15
# For first-owner setup on a hosted instance. Use a strong random value.
# SETUP_TOKEN=
